# =============================================================================
# SHUBBLE PRODUCTION ENVIRONMENT CONFIGURATION
# =============================================================================
# Shared environment variables (Dokploy project level).
# Copy to .env and update with real values before deploying.

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_URL=postgresql://shubble:shubble@postgres:5432/shubble

# =============================================================================
# REDIS CACHE
# =============================================================================
REDIS_URL=redis://redis:6379/0

# =============================================================================
# APPLICATION
# =============================================================================
DEBUG=false
LOG_LEVEL=INFO
# Use "production" for the live site (disables the staging banner/noindex tag
# on the frontend). "staging" behaves identically on the backend but the
# frontend will show a staging banner and block search indexing.
DEPLOY_MODE=production

# Per-component log level overrides (optional, fall back to LOG_LEVEL)
FASTAPI_LOG_LEVEL=
WORKER_LOG_LEVEL=
ML_LOG_LEVEL=

# =============================================================================
# SERVICE URLS
# =============================================================================
FRONTEND_URLS=https://shubble.example.com

# Only needed if the test-server app is deployed (e.g. a staging environment
# without real Samsara credentials)
TEST_FRONTEND_URL=

# =============================================================================
# API KEYS & SECRETS
# =============================================================================
# Samsara API key (required outside DEPLOY_MODE=development)
API_KEY=

# Samsara webhook secret (base64 encoded)
SAMSARA_SECRET=


# =============================================================================
# SHUBBLE SETTINGS
# =============================================================================
# %H:%M:%S format, 24-hour time, default is midnight
DAY_START=

# Use schedule-based static ETAs on the frontend instead of the ML worker's
# live predictions. Does not stop the ml_worker service from running -
# omit that app from the Dokploy deployment to disable ML compute entirely.
STATIC_ETAS=false
